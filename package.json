{
  "name": "electromagaz",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "dev:local": "tsx scripts/with-local-db.ts npm run dev -- --webpack",
    "build": "prisma generate && next build",
    "build:local": "tsx scripts/with-local-db.ts npm run build",
    "postinstall": "prisma generate",
    "start": "next start",
    "lint": "eslint",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:integration": "vitest --run --config vitest.integration.config.ts",
    "test:e2e": "playwright test",
    "test:e2e:local": "tsx scripts/with-local-db.ts npm run test:e2e",
    "test:e2e:update": "playwright test --update-snapshots",
    "db:migrate": "prisma migrate dev",
    "db:migrate:local": "tsx scripts/with-local-db.ts npm exec prisma -- migrate deploy",
    "db:studio": "prisma studio",
    "db:generate": "prisma generate",
    "db:seed:local-mvp": "tsx prisma/seed-local-mvp.ts",
    "db:sync-local-password": "tsx scripts/sync-local-db-password.ts",
    "enrichment:run": "tsx src/scripts/enrichment-run.mts",
    "enrichment:run:local": "tsx scripts/with-local-db.ts npm run enrichment:run --",
    "enrichment:status": "tsx src/scripts/enrichment-status.mts",
    "enrichment:status:local": "tsx scripts/with-local-db.ts npm run enrichment:status --",
    "enrichment:watch": "tsx src/scripts/enrichment-status.mts --watch",
    "enrichment:reenrich": "tsx scripts/reenrich-unresolved.ts",
    "db:stats": "tsx scripts/check-db-stats.ts",
    "db:stats:local": "tsx scripts/with-local-db.ts npm run db:stats",
    "db:check:local-mvp": "tsx scripts/with-local-db.ts npm exec tsx -- scripts/check-local-mvp.ts",
    "check:db-failure:local": "tsx scripts/check-unavailable-db.ts",
    "check:production-config": "tsx scripts/check-production-config.ts",
    "db:publish": "tsx scripts/db-publish.ts",
    "catalog:rebuild-tree": "tsx scripts/rebuild-category-tree.ts",
    "catalog:restore-tree": "tsx scripts/restore-category-backup.ts",
    "images:backfill": "tsx scripts/backfill-images-to-r2.ts",
    "images:reclassify": "tsx scripts/reclassify-images.ts",
    "images:gen-packages": "tsx scripts/gen-package-svgs.ts",
    "images:cleanup-r2": "tsx scripts/cleanup-r2-originals.ts",
    "datasheets:process": "tsx scripts/process-datasheets-to-r2.ts",
    "datasheets:process:local": "tsx scripts/with-local-db.ts npm run datasheets:process --"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1055.0",
    "@gsap/react": "^2.1.2",
    "@prisma/client": "^5.22.0",
    "cheerio": "^1.2.0",
    "cloakbrowser": "^0.3.29",
    "csv-parse": "^6.2.1",
    "dotenv": "^17.4.2",
    "gsap": "^3.15.0",
    "ink": "^7.0.3",
    "lucide-react": "^1.0.1",
    "next": "16.3.0",
    "playwright-core": "^1.60.0",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "sharp": "0.35.3"
  },
  "devDependencies": {
    "@playwright/test": "^1.59.1",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitest/coverage-v8": "4.1.10",
    "@vitest/ui": "4.1.10",
    "eslint": "^9",
    "eslint-config-next": "16.3.0",
    "fast-check": "^4.8.0",
    "happy-dom": "20.11.2",
    "ink-testing-library": "^4.0.0",
    "playwright": "^1.59.1",
    "prisma": "^5.22.0",
    "tailwindcss": "^4",
    "tsx": "^4.7.0",
    "typescript": "^5",
    "vitest": "4.1.10",
    "xlsx": "0.18.5"
  }
}
