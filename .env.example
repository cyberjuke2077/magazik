# Database Configuration
POSTGRES_USER=postgres
POSTGRES_PASSWORD=your_secure_password_here
POSTGRES_DB=electromagaz

# Database Connection URL (used by Prisma)
DATABASE_URL="postgresql://${POSTGRES_USER}:${POSTGRES_PASSWORD}@localhost:5432/${POSTGRES_DB}"

# pgAdmin Configuration
PGADMIN_DEFAULT_EMAIL=admin@electromagaz.local
PGADMIN_DEFAULT_PASSWORD=your_secure_pgadmin_password_here

# Next.js Configuration
NEXTAUTH_SECRET=your_nextauth_secret_here
NEXTAUTH_URL=http://localhost:3000

# Meilisearch Configuration (for future use)
MEILISEARCH_HOST=http://localhost:7700
MEILISEARCH_API_KEY=your_meilisearch_api_key_here

# === Enrichment Pipeline ===
ENRICHMENT_INPUT_DIR=/path/to/supplier/excel/files
MOUSER_API_KEY=your_mouser_api_key_here

# ChipDip proxy (OPTIONAL — CloakBrowser works without proxy by default)
CHIPDIP_PROXY_TEMPLATE=
CHIPDIP_PROXY_USER_RANGE=1,20000
CHIPDIP_CONCURRENCY=1

# Pipeline settings
ENRICHMENT_BATCH_SIZE=500
ENRICHMENT_PERSIST_BATCH=50

# === R2 (Cloudflare) — product image storage ===
# Получить: dash.cloudflare.com → R2 → Manage R2 API Tokens → Create
# Permissions: Object Read & Write для конкретного bucket. TTL: Forever.
# Если переменные не заданы — enrichment fall-back к внешним URL источников.
R2_ENDPOINT=https://<account_id>.r2.cloudflarestorage.com
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=electromagaz-images
# Public URL: bucket → Settings → R2.dev subdomain → Allow Access
# либо custom domain, e.g. https://images.electromagaz.example.com
R2_PUBLIC_URL=https://pub-<hash>.r2.dev

# === db:publish — публикация каталога в прод (Supabase) ===
# Direct/session connection (порт 5432, не pgbouncer). Источник: Supabase → Settings → Database
PUBLISH_DATABASE_URL="postgresql://postgres.<project_ref>:<password>@aws-1-eu-central-1.pooler.supabase.com:5432/postgres"

# === Админ-панель ===
ADMIN_PASSWORD=strong_admin_password_here
ADMIN_SESSION_SECRET=random_hex_64_chars   # openssl rand -hex 32

# === Telegram-уведомления о заявках (опционально) ===
# Создать бота: @BotFather → /newbot. chat_id: написать боту, затем
# https://api.telegram.org/bot<TOKEN>/getUpdates → message.chat.id
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
