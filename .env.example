# Local Docker PostgreSQL
POSTGRES_USER=electromagaz
POSTGRES_PASSWORD=change-me-local-db-password
POSTGRES_DB=electromagaz
PGADMIN_DEFAULT_EMAIL=admin@example.local
PGADMIN_DEFAULT_PASSWORD=change-me-local-pgadmin-password

# Prisma. For local Docker, DIRECT_URL is the same direct connection.
DATABASE_URL="postgresql://electromagaz:change-me-local-db-password@localhost:5432/electromagaz?schema=public"
DIRECT_URL="postgresql://electromagaz:change-me-local-db-password@localhost:5432/electromagaz?schema=public"

# Local app and admin access
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXTAUTH_URL=http://localhost:3000
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me-local-admin-password
# Generate a unique value locally: openssl rand -hex 32
ADMIN_SESSION_SECRET=replace-with-a-random-32-byte-secret

# Optional. Required only for enrichment, publishing, R2 maintenance or notifications.
ENRICHMENT_INPUT_DIR=./data/input
ENRICHMENT_BATCH_SIZE=500
ENRICHMENT_PERSIST_BATCH=50
ENRICHMENT_SKIP_FRESH=true
ENRICHMENT_FRESHNESS_DAYS=90
MOUSER_API_KEY=
CHIPDIP_PROXY_TEMPLATE=
CHIPDIP_PROXY_URL=
CHIPDIP_PROXY_USER_RANGE=1,20000
CHIPDIP_CONCURRENCY=1
CHIPDIP_REQUEST_DELAY_MIN_MS=30000
CHIPDIP_REQUEST_DELAY_MAX_MS=60000
CHIPDIP_PAGE_DELAY_MIN_MS=1500
CHIPDIP_PAGE_DELAY_MAX_MS=3500
CAPTCHA_2CAPTCHA_API_KEY=
CAPTCHA_PROVIDER_URL=https://rucaptcha.com
R2_ENDPOINT=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
R2_PUBLIC_URL=
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Production Supabase connection. Leave empty for normal local development.
PUBLISH_DATABASE_URL=
