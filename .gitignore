# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug / logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*
*.log
logs/
parser.pid

# env files (шаблон .env.example — в репо)
.env*
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# session files
.tmp/

# python
__pycache__/
*.py[cod]
*$py.class
venv/
venv-test/
.pytest_cache/

# editors / IDE
.vscode/
.idea/
.kiro/
.opencode/
.opencode-router/
.agents/

# backups / one-shot artifacts
*.bak
*.orig

# collector / parser runtime state
data/progress.db
data/progress.db-journal
data/progress.db-wal
data/progress.db-shm

# storage (local artifacts; whitelist source dir)
storage/
!src/lib/storage/

# ruflo runtime state (agentdb, ruvector)
agentdb.rvf
agentdb.rvf.lock
ruvector.db

# claude code local settings (permissions etc.)
.claude/settings.local.json
