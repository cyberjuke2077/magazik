[Unit]
Description=Electromagaz Next.js application
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=electromagaz
Group=electromagaz
WorkingDirectory=/srv/electromagaz/current
Environment=NODE_ENV=production
Environment=NEXT_TELEMETRY_DISABLED=1
EnvironmentFile=/etc/electromagaz/runtime.env
ExecStart=/usr/bin/node node_modules/next/dist/bin/next start --hostname 127.0.0.1 --port 3000
Restart=on-failure
RestartSec=5
TimeoutStopSec=30
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
ReadWritePaths=/srv/electromagaz/current/.next/cache
UMask=0077

[Install]
WantedBy=multi-user.target
